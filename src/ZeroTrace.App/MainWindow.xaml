<Window x:Class="ZeroTrace.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ZeroTrace Workstation" Width="1120" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"><Grid Background="#0B1117"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Padding="28,22" Background="#101A24"><StackPanel><TextBlock Text="ZEROTRACE WORKSTATION" Foreground="#EAF7FF" FontSize="28" FontWeight="Bold"/><TextBlock Text="Diagnostic &amp; Remediation Platform" Foreground="#77DDF7" FontSize="15"/></StackPanel></Border><Grid Grid.Row="1" Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><Border Padding="24" Margin="0,0,18,0" CornerRadius="16" Background="#101A24"><StackPanel><TextBlock Text="WORKSTATION STATUS" Foreground="#A8B9C6"/><TextBlock Text="{Binding StatusHeadline}" Foreground="#F5FAFD" FontSize="30" FontWeight="Bold" Margin="0,18,0,8"/><TextBlock Text="{Binding ModeText}" Foreground="#77DDF7" FontSize="16"/><Button Content="RUN FOUNDATION DIAGNOSTIC" Command="{Binding RunDiagnosticCommand}" Margin="0,30,0,0" Height="48"/></StackPanel></Border><Border Grid.Column="1" Padding="24" CornerRadius="16" Background="#101A24"><StackPanel><TextBlock Text="FOUNDATION" Foreground="#A8B9C6"/><TextBlock Text="Diagnose First. Change Second." Foreground="#F5FAFD" FontSize="24" FontWeight="Bold" Margin="0,18,0,16"/><TextBlock TextWrapping="Wrap" Foreground="#BCCAD4" FontSize="15" Text="Architecture validation build. No destructive remediation is enabled. Diagnostics are local-first, privacy-focused and enterprise-aware by design."/></StackPanel></Border></Grid><Border Grid.Row="2" Padding="28,14" Background="#0E171F"><TextBlock Text="v0.1.0 FOUNDATION • NO TELEMETRY • NO CLOUD REQUIRED" Foreground="#7F94A3"/></Border></Grid></Window>